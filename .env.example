# ===========================================================================
# AD-BoN Runtime Gateway — Environment Configuration Example
# ===========================================================================
# Copy this file to '.env' in local development. Never commit real secrets.

# 1. API Authentication Secret (Bearer token required for protected endpoints)
ADBON_API_KEY=your_gateway_api_key_here

# 2. Routing Signal HMAC Secret (Used to sign and verify internal signals)
ADBON_SIGNAL_SECRET=your_signal_secret_here

# 3. Replay Protection Window (in seconds, default: 300 = 5 minutes)
ADBON_REPLAY_WINDOW=300

# 4. Groq Model Provider Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_JUNIOR_MODEL=llama-3.1-8b-instant
GROQ_MEDIUM_MODEL=llama-3.3-70b-versatile
GROQ_SENIOR_MODEL=openai/gpt-oss-120b

# 5. Multimodal Fallbacks (Optional)
GEMINI_API_KEY=your-gemini-api-key-here
