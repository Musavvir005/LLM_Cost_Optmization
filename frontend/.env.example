# Backend API Base URL
# For local dev: leave blank to use the Vite proxy (/api -> http://127.0.0.1:8000)
# For production (Vercel): set to your cloud backend URL (e.g. https://llm-cost-backend.onrender.com or https://xxxx.ngrok-free.app)
VITE_API_BASE_URL=

# Backend Bearer API key (must match ADBON_API_KEY on the backend)
VITE_API_KEY=adbon-sec-key-2026-demo
